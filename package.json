{
  "name": "wildlife-minds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "supabase start && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "test": "start-server-and-test dev http://localhost:3000 cypress:headless",
    "test:ui": "start-server-and-test dev http://localhost:3000 cypress",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "mail:view": "open http://localhost:54324",
    "studio:view": "open http://localhost:54323",
    "db:backup-config": "cp supabase/config.toml supabase/config.local.toml",
    "db:restore-config": "mv supabase/config.local.toml supabase/config.toml",
    "db:clean-config": "sed '/flow_state_expiry/d; /code_expiry/d' supabase/config.local.toml > supabase/config.toml",
    "db:link-test": "npm run db:backup-config && npm run db:clean-config && supabase link --project-ref $SUPABASE_TEST_REF && npm run db:restore-config",
    "db:link-prod": "npm run db:backup-config && npm run db:clean-config && supabase link --project-ref $SUPABASE_PROD_REF && npm run db:restore-config",
    "db:push-test": "npm run db:backup-config && npm run db:clean-config && supabase db push && npm run db:restore-config",
    "db:push-prod": "npm run db:backup-config && npm run db:clean-config && supabase db push && npm run db:restore-config"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.16",
    "framer-motion": "^11.15.0",
    "next": "15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.1",
    "react-icons": "^5.4.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "postcss": "^8",
    "start-server-and-test": "^2.0.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}